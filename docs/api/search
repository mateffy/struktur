anation/parsers-15","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"716":{"id":"/docs/explanation/parsers-16","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"717":{"id":"/docs/explanation/parsers-17","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"MIME type"},"718":{"id":"/docs/explanation/parsers-18","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Behavior"},"719":{"id":"/docs/explanation/parsers-19","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`application/pdf`"},"720":{"id":"/docs/explanation/parsers-20","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Per-page text via `pdf-parse`. Embedded images require `--images`. Page screenshots require `--screenshots`. Image deduplication filters images smaller than \\~80px. Non-fatal on image/screenshot failures."},"721":{"id":"/docs/explanation/parsers-21","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`text/*`"},"722":{"id":"/docs/explanation/parsers-22","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Split on double newlines into content slices."},"723":{"id":"/docs/explanation/parsers-23","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`image/*`"},"724":{"id":"/docs/e