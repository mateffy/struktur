rl":"/docs/explanation/artifact-format#images","content":"`type`"},"436":{"id":"/docs/explanation/artifact-format-64","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Yes"},"437":{"id":"/docs/explanation/artifact-format-65","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Must be `\"image\"`"},"438":{"id":"/docs/explanation/artifact-format-66","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`url`"},"439":{"id":"/docs/explanation/artifact-format-67","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"No"},"440":{"id":"/docs/explanation/artifact-format-68","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"URL to image (mutually exclusive with `base64`)"},"441":{"id":"/docs/explanation/artifact-format-69","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`base64`"},"442":{"id":"/docs/explanation/artifact-format-70","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"No"},"443":{"id":"/docs/explanation/artifact-format-71","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Base64-encoded image data (no data-URL prefix)"},"444":{"id":"/docs/explanation/artifact-format-72","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`text`"},"445":{"id":"/docs/explanation/artifact-format-73","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"No"},"446":{"id":"/docs/explanation/artifact-format-74","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Alt text or OCR output"},"447":{"id":"/docs/explanation/artifact-format-75","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`x`, `y`, `width`, `height`"},"448":{"id":"/docs/explanation/artifact-format-76","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"No"},"449":{"id":"/docs/explanation/artifact-format-77","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Optional spatial metadata (pixels)"},"450":{"id":"/docs/explanation/artifact-format-78","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`imageType`"},"451":{"id":"/docs/explanation/artifact-format-79","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"No"},"452":{"id":"/docs/explanation/artifact-format-80","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"`\"embedded\"` or `\"screenshot\"`. Distinguishes images extracted from the document body from page renders. Omit for hand-crafted artifacts."},"453":{"id":"/docs/explanation/artifact-format-81","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"Either `url` or `base64` must be present."},"454":{"id":"/docs/explanation/artifact-format-82","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#images","content":"The `imageType` field is set automatically by the PDF parser: `\"embedded\"` for images extracted from the PDF body (requires `--images`), `\"screenshot\"` for full-page renders (requires `--screenshots`). The artifact viewer uses this field to filter and badge images independently."},"455":{"id":"/docs/explanation/artifact-format-83","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#validation","content":"Struktur validates artifact JSON before processing. Use the CLI:"},"456":{"id":"/docs/explanation/artifact-format-84","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#validation","content":"Returns `{ \"valid\": true, \"artifacts\": 1 }` on success, throws with error detail on failure."},"457":{"id":"/docs/explanation/artifact-format-85","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Path"},"458":{"id":"/docs/explanation/artifact-format-86","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Description"},"459":{"id":"/docs/explanation/artifact-format-87","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`--input <file>` (CLI)"},"460":{"id":"/docs/explanation/artifact-format-88","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"MIME detection + parser resolution; PDF uses built-in `parsePdf`"},"461":{"id":"/docs/explanation/artifact-format-89","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`--stdin` (CLI)"},"462":{"id":"/docs/explanation/artifact-format-90","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"MIME detection on buffer; `text/plain` falls back to text artifact"},"463":{"id":"/docs/explanation/artifact-format-91","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`parse()` (SDK)"},"464":{"id":"/docs/explanation/artifact-format-92","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Accepts `kind: \"text\"`, `kind: \"file\"`, `kind: \"buffer\"`, `kind: \"artifact-json\"`"},"465":{"id":"/docs/explanation/artifact-format-93","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`urlToArtifact()` (SDK)"},"466":{"id":"/docs/explanation/artifact-format-94","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Fetches URL, validates as `SerializedArtifact[]`"},"467":{"id":"/docs/explanation/artifact-format-95","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#see-also","content":"Document Parsing — how to get input into Struktur and how files are converted to artifacts"},"468":{"id":"/docs/explanation/artifact-format-96","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#see-also","content":"parse() — the SDK API"},"469":{"id":"/docs/explanation/chunking","page_id":"/docs/explanation/chunking","type":"page","content":"Chunking & Token Budgets","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/chunking"},"470":{"id":"/docs/explanation/chunking-0","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking","content":"How large documents are split and merged to fit within context windows."},"471":{"id":"/docs/explanation/chunking-1","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#the-context-window-problem","content":"The context window problem"},"472":{"id":"/docs/explanation/chunking-2","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#how-splitting-works","content":"How splitting works"},"473":{"id":"/docs/explanation/chunking-3","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#images-and-maximages","content":"Images and `maxImages`"},"474":{"id":"/docs/explanation/chunking-4","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"Why `simple` does not chunk"},"475":{"id":"/docs/explanation/chunking-5","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#merging-partial-results","content":"Merging partial results"},"476":{"id":"/docs/explanation/chunking-6","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"LLM merge (parallel, doublePass)"},"477":{"id":"/docs/explanation/chunking-7","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"Schema-aware auto-merge"},"478":{"id":"/docs/explanation/chunking-8","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#deduplication","content":"Deduplication"},"479":{"id":"/docs/explanation/chunking-9","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#when-dedup-matters","content":"When dedup matters"},"480":{"id":"/docs/explanation/chunking-10","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#see-also","content":"See also"},"481":{"id":"/docs/explanation/chunking-11","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#the-context-window-problem","content":"LLMs have finite context windows. Documents — especially multi-page PDFs, large datasets, or many files at once — often exceed them. Struktur's chunker splits artifact contents into batches that fit within a configurable token budget (`chunkSize`)."},"482":{"id":"/docs/explanation/chunking-12","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"Splitting happens at two levels:"},"483":{"id":"/docs/explanation/chunking-13","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactSplitter:** splits a single large artifact's contents into smaller parts, respecting content slice boundaries (e.g., page boundaries)."},"484":{"id":"/docs/explanation/chunking-14","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactBatcher:** groups artifacts or artifact parts into batches that stay within the token budget and optional image count limit."},"485":{"id":"/docs/explanation/chunking-15","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"The tokenizer uses a character-approximation (not exact token counting). `chunkSize` defaults to 10,000 tokens."},"486":{"id":"/docs/explanation/chunking-16","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#images-and-maximages","content":"Some strategies accept `maxImages` to cap how many images appear per chunk. This matters when images consume disproportionate context. If a batch would exceed `maxImages`, extra images are moved to the next batch."},"487":{"id":"/docs/explanation/chunking-17","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"The `simple` strategy loads all artifacts as-is. If the input exceeds the context window, the LLM call may fail or produce degraded results. For large inputs, use a chunked strategy."},"488":{"id":"/docs/explanation/chunking-18","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"This is a deliberate trade-off: `simple` is fast and cheap for small inputs, not suitable for large ones."},"489":{"id":"/docs/explanation/chunking-19","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"When a document is split into N chunks and each chunk is extracted independently, you get N partial objects."},"490":{"id":"/docs/explanation/chunking-20","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For a scalar-heavy schema (title, author, date), you want the best answer from all chunks."},"491":{"id":"/docs/explanation/chunking-21","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For an array-heavy schema (line items, product listings), you want to concatenate all arrays and remove duplicates."},"492":{"id":"/docs/explanation/chunking-22","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"These strategies send all partial results to a **merge model** in a single call, with a prompt asking it to produce a single coherent output. The merge model sees the full schema and all partial outputs."},"493":{"id":"/docs/explanation/chunking-23","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"This is powerful but costs extra tokens."},"494":{"id":"/docs/explanation/chunking-24","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"`parallelAutoMerge`, `sequentialAutoMerge`, and `doublePassAutoMerge` use `SmartDataMerger`:"},"495":{"id":"/docs/explanation/chunking-25","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Arrays:** concatenated. `items` from chunk 1 + `items` from chunk 2 = `items` in merged."},"496":{"id":"/docs/explanation/chunking-26","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Objects:** shallow-merged. Keys from later chunks overwrite keys from earlier ones."},"497":{"id":"/docs/explanation/chunking-27","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Scalars:** prefer newer non-empty values."},"498":{"id":"/docs/explanation/chunking-28","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"This approach avoids an extra LLM call and works well for list-extraction schemas. It does not handle complex cross-chunk synthesis — for that, use LLM merge."},"499":{"id":"/docs/explanation/chunking-29","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"After auto-merging concatenated arrays, there may be duplicates. Dedup runs in two stages:"},"500":{"id":"/docs/explanation/chunking-30","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 1: CRC32 hash-based.** Exact duplicates (byte-for-byte identical after stable JSON stringification) are removed without any LLM call. Fast and cheap."},"501":{"id":"/docs/explanation/chunking-31","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 2: LLM-based semantic dedup.** A dedupe model is given the merged array and asked to identify semantically equivalent entries (e.g., \"iPhone 15\" vs \"Apple iPhone 15 128GB\"). It returns a list of dot-path keys to remove (e.g., `items.3`)."},"502":{"id":"/docs/explanation/chunking-32","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"Only the auto-merge variants include this step."},"503":{"id":"/docs/explanation/chunking-33","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup is valuable when:"},"504":{"id":"/docs/explanation/chunking-34","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same item legitimately appears in multiple chunks."},"505":{"id":"/docs/explanation/chunking-35","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same document segment appears in multiple artifacts."},"506":{"id":"/docs/explanation/chunking-36","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup adds token cost and latency. For schemas without arrays, or for inputs with no expected overlap, use strategies without auto-merge."},"507":{"id":"/docs/explanation/chunking-37","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"The Extraction Pipeline — the full flow"},"508":{"id":"/docs/explanation/chunking-38","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"Extraction Strategies — which strategies use chunking"},"509":{"id":"/docs/explanation/document-parsing","page_id":"/docs/explanation/document-parsing","type":"page","content":"Document Parsing","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/document-parsing"},"510":{"id":"/docs/explanation/document-parsing-0","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"How Struktur converts files into Artifacts before extraction."},"511":{"id":"/docs/explanation/document-parsing-1","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#mime-detection","content":"MIME Detection"},"512":{"id":"/docs/explanation/document-parsing-2","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#built-in-parsers","content":"Built-in Parsers"},"513":{"id":"/docs/explanation/document-parsing-3","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#built-in-input-types","content":"Built-in Input Types"},"514":{"id":"/docs/explanation/document-parsing-4","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Plain text / markdown (CLI)"},"515":{"id":"/docs/explanation/document-parsing-5","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#artifact-json-cli","content":"Artifact JSON (CLI)"},"516":{"id":"/docs/explanation/document-parsing-6","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#schema-loading","content":"Schema loading"},"517":{"id":"/docs/explanation/document-parsing-7","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#custom-parsers","content":"Custom Parsers"},"518":{"id":"/docs/explanation/document-parsing-8","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-1-configuration-level-recommended","content":"Option 1: Configuration-level (recommended)"},"519":{"id":"/docs/explanation/document-parsing-9","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-2-sdk-level-inline-parser","content":"Option 2: SDK-level inline parser"},"520":{"id":"/docs/explanation/document-parsing-10","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#the-inline-parser-signature","content":"The inline parser signature"},"521":{"id":"/docs/explanation/document-parsing-11","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#common-patterns","content":"Common patterns"},"522":{"id":"/docs/explanation/document-parsing-12","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#excel-with-xlsx-package","content":"Excel with xlsx package"},"523":{"id":"/docs/explanation/document-parsing-13","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#email-with-mailparser","content":"Email with mailparser"},"524":{"id":"/docs/explanation/document-parsing-14","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-3-legacy-providers-deprecated","content":"Option 3: Legacy providers (deprecated)"},"525":{"id":"/docs/explanation/document-parsing-15","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanat