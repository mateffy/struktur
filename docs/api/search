":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-3-legacy-providers-deprecated","content":"Option 3: Legacy providers (deprecated)"},"658":{"id":"/docs/explanation/document-parsing-17","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#npm-package-parser","content":"npm Package Parser"},"659":{"id":"/docs/explanation/document-parsing-18","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#shell-command-parsers","content":"Shell Command Parsers"},"660":{"id":"/docs/explanation/document-parsing-19","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#file-based","content":"File-based"},"661":{"id":"/docs/explanation/document-parsing-20","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#stdin-based","content":"Stdin-based"},"662":{"id":"/docs/explanation/document-parsing-21","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parser-resolution-order","content":"Parser Resolution Order"},"663":{"id":"/docs/explanation/document-parsing-22","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#ad-hoc-parser-override","content":"Ad-hoc Parser Override"},"664":{"id":"/docs/explanation/document-parsing-23","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#sdk-usage","content":"SDK Usage"},"665":{"id":"/docs/explanation/document-parsing-24","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parseinput-options","content":"`parse(input, options?)`"},"666":{"id":"/docs/explanation/document-parsing-25","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#filetoartifactbuffer-options","content":"`fileToArtifact(buffer, options)`"},"667":{"id":"/docs/explanation/document-parsing-26","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#urltoartifacturl","content":"`urlToArtifact(url)`"},"668":{"id":"/docs/explanation/document-parsing-27","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#see-also","content":"See also"},"669":{"id":"/docs/explanation/document-parsing-28","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"670":{"id":"/docs/explanation/document-parsing-29","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"671":{"id":"/docs/explanation/document-parsing-30","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"672":{"id":"/docs/explanation/document-parsing-31","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**npm `detectFileType` callback**: A custom npm parser may export a `detectFileType(header: Uint8Array): boolean` function to claim MIME types beyond what magic bytes cover."},"673":{"id":"/docs/explanation/document-parsing-32","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"674":{"id":"/docs/explanation/document-parsing-33","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"675":{"id":"/docs/explanation/document-parsing-34","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"MIME type"},"676":{"id":"/docs/explanation/document-parsing-35","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Behavior"},"677":{"id":"/docs/explanation/document-parsing-36","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/pdf`"},"678":{"id":"/docs/explanation/document-parsing-37","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Per-page text via `pdf-parse` (or the selected `--processor`). Embedded images require `--images`. Page screenshots require `--screenshots`. Image deduplication filters images smaller than \\~80px. Non-fatal on image/screenshot failures."},"679":{"id":"/docs/explanation/document-parsing-38","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`text/*`"},"680":{"id":"/docs/explanation/document-parsing-39","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Split on double newlines into content slices."},"681":{"id":"/docs/explanation/document-parsing-40","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`image/*`"},"682":{"id":"/docs/explanation/document-parsing-41","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Single-content artifact with one media item."},"683":{"id":"/docs/explanation/document-parsing-42","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/json`"},"684":{"id":"/docs/explanation/document-parsing-43","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"If it validates as `SerializedArtifact[]`, passed through unchanged without invoking any parser."},"685":{"id":"/docs/explanation/document-parsing-44","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"PDF text extraction is pluggable. Select a backend with `--processor` (CLI) or the `processor` parse option (SDK). Non-default processors are loaded on demand, so the default install stays dependency-free."},"686":{"id":"/docs/explanation/document-parsing-45","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Processor"},"687":{"id":"/docs/explanation/document-parsing-46","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"What it does"},"688":{"id":"/docs/explanation/document-parsing-47","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Requires"},"689":{"id":"/docs/explanation/document-parsing-48","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`pdf-parse`"},"690":{"id":"/docs/explanation/document-parsing-49","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Default. Fast per-page text extraction, no layout awareness."},"691":{"id":"/docs/explanation/document-parsing-50","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"—"},"692":{"id":"/docs/explanation/document-parsing-51","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`vlm`"},"693":{"id":"/docs/explanation/document-parsing-52","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Renders each page and asks a vision model to transcribe it. Best for scanned or heavily designed documents."},"694":{"id":"/docs/explanation/document-parsing-53","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Ghostscript (`gs`) and a model"},"695":{"id":"/docs/explanation/document-parsing-54","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`docling`"},"696":{"id":"/docs/explanation/document-parsing-55","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"IBM Docling — layout analysis, tables preserved as markdown."},"697":{"id":"/docs/explanation/document-parsing-56","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`pip install docling`"},"698":{"id":"/docs/explanation/document-parsing-57","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`liteparse`"},"699":{"id":"/docs/explanation/document-parsing-58","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"LlamaIndex's lightweight layout parser."},"700":{"id":"/docs/explanation/document-parsing-59","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`@llamaindex/liteparse` npm package"},"701":{"id":"/docs/explanation/document-parsing-60","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`kreuzberg`"},"702":{"id":"/docs/explanation/document-parsing-61","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"Kreuzberg's unified document extractor."},"703":{"id":"/docs/explanation/document-parsing-62","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#pdf-processors","content":"`@kreuzberg/node` npm package"},"704":{"id":"/docs/explanation/document-parsing-63","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"When `--images` is enabled, the PDF parser composes one extra generated image on top of the extracted ones: a labelled **image overview**. It is a contact sheet containing a thumbnail of every extracted image, each captioned with its virtual path (split across several numbered sheets when a document has many images)."},"705":{"id":"/docs/explanation/document-parsing-64","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"The overview lets a vision model see the entire visual content of a document for the cost of one image, so it can decide which images are worth opening in full instead of reading them all. It is also what the agent's context prefill loads first."},"706":{"id":"/docs/explanation/document-parsing-65","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Property"},"707":{"id":"/docs/explanation/document-parsing-66","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Value"},"708":{"id":"/docs/explanation/document-parsing-67","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Thumbnail size"},"709":{"id":"/docs/explanation/document-parsing-68","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"\\~220px longest edge, aspect preserved (120px floor)"},"710":{"id":"/docs/explanation/document-parsing-69","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Sheet ceiling"},"711":{"id":"/docs/explanation/document-parsing-70","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"1500px longest edge — larger sets split into numbered sheets"},"712":{"id":"/docs/explanation/document-parsing-71","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Filtered out"},"713":{"id":"/docs/explanation/document-parsing-72","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Byte-identical repeats, and images under 40px in either dimension"},"714":{"id":"/docs/explanation/document-parsing-73","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"`imageType`"},"715":{"id":"/docs/explanation/document-parsing-74","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"`\"screenshot\"`"},"716":{"id":"/docs/explanation/document-parsing-75","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"Disable with"},"717":{"id":"/docs/explanation/document-parsing-76","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"`struktur parse --no-image-overview`"},"718":{"id":"/docs/explanation/document-parsing-77","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#image-overview","content":"The overview appears in the artifact as a normal media item, so it flows through `--artifact-file`, the artifact viewer, and `--images-output` like any other image."},"719":{"id":"/docs/explanation/document-parsing-78","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Flag"},"720":{"id":"/docs/explanation/document-parsing-79","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Description"},"721":{"id":"/docs/explanation/document-parsing-80","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"`--stdin`"},"722":{"id":"/docs/explanation/document-parsing-81","page_id":"/docs/explanation/document-parsing","tags":[],"type":"