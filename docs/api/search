 explicit `mimeType`."},"589":{"id":"/docs/explanation/document-parsing-79","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#npm-package-parser","content":"Install a package that implements the `NpmParserModule` interface:"},"590":{"id":"/docs/explanation/document-parsing-80","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#npm-package-parser","content":"When both `parseFile` and `parseStream` are exported, Struktur prefers `parseFile` for file inputs (zero-copy) and `parseStream` for buffer or stdin inputs. A temp file is created as a fallback if needed."},"591":{"id":"/docs/explanation/document-parsing-81","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#npm-package-parser","content":"Register it:"},"592":{"id":"/docs/explanation/document-parsing-82","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#file-based","content":"The `FILE_PATH` placeholder is replaced with the actual file path at runtime. For buffer inputs, a temp file is created automatically."},"593":{"id":"/docs/explanation/document-parsing-83","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#file-based","content":"`FILE_PATH` must appear in the command string — an error is thrown if it is missing."},"594":{"id":"/docs/explanation/document-parsing-84","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#file-based","content":"The command must write `SerializedArtifact[]` JSON to stdout."},"595":{"id":"/docs/explanation/document-parsing-85","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#stdin-based","content":"File contents are piped to the command's stdin."},"596":