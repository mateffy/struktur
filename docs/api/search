732":{"id":"/docs/explanation/parsers-32","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-file-based","content":"`FILE_PATH` must appear in the command string — an error is thrown if it is missing."},"733":{"id":"/docs/explanation/parsers-33","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-file-based","content":"The command must write `SerializedArtifact[]` JSON to stdout."},"734":{"id":"/docs/explanation/parsers-34","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-stdin-based","content":"File contents are piped to the command's stdin."},"735":{"id":"/docs/explanation/parsers-35","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-stdin-based","content":"The command must write `SerializedArtifact[]` JSON to stdout. Plain text output will fail validation."},"736":{"id":"/docs/explanation/parsers-36","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"For any input, parsers are resolved in this order:"},"737":{"id":"/docs/explanation/parsers-37","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"`--parser <pkg>` flag on the CLI — always wins, bypasses all config"},"738":{"id":"/docs/explanation/parsers-38","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Parser configured for the detected MIME type (`config parsers add`)"},"739":{"id":"/docs/explanation/parsers-39","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Built-in parser (PDF, text/\\*, image/\\*, JSON)"},"740":{"id":"/docs/explanation/parsers-40","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Error with a suggestion to use `config parsers add`"},"741":{"id":"/docs/explanation/parsers-41","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#ad-hoc-parser-override","content":"Use `--parser` to override the configured parser for a single run without changing config:"},"742":{"id":"/docs/explanation/parsers-42","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#sdk-usage","content":"Pass a `parserConfig` to `parseInputToArtifacts` to use custom parsers without CLI config:"},"743":{"id":"/docs/explanation/parsers-43","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"config parsers — CLI commands for managing parsers"},"744":{"id":"/docs/explanation/parsers-44","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"parse — Convert files to artifact JSON"},"745":{"id":"/docs/explanation/parsers-45","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"Artifact Format — The output data structure"},"746":{"id":"/docs/explanation/parsers-46","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"Built-in Input Types — SDK input helpers"},"747":{"id":"/docs/explanation/pipeline","page_id":"/docs/explanation/pipeline","type":"page","content":"Extraction Lifecycle","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/pipeline"},"748":{"id":"/docs/explanation/pipeline-0","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline","content":"How data flows through Struktur from input to output."},"749":{"id":"/docs/explanation/pipeline-1","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Inputs and Artifacts"},"750":{"id":"/docs/explanation/pipeline-2","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-strategy-layer","content":"The Strategy layer"},"751":{"id":"/docs/explanation/pipeline-3","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Validation inside the loop"},"752":{"id":"/docs/explanation/pipeline-4","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-result","content":"The result"},"753":{"id":"/docs/explanation/pipeline-5","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#see-also","content":"See also"},"754":{"id":"/docs/explanation/pipeline-6","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Struktur converts input files into **Artifacts** before extraction. For plain text or stdin, this is trivial. For structured files (PDFs, Office documents), Struktur runs a parser — built-in or custom — that extracts text and images per-page."},"755":{"id":"/docs/explanation/pipeline-7","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"See Parsers for how files are converted to artifacts.\nSee Artifact Format for the data structure."},"756":{"id":"/docs/explanation/pipeline-8","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"A strategy is the orchestration engine. It decides how to split the input, how many LLM calls to make, whether to run them concurrently or sequentially, and how to combine results."},"757":{"id":"/docs/explanation/pipeline-9","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"Built-in strategies cover the common patterns. You can also write your own."},"758":{"id":"/docs/explanation/pipeline-10","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"See Strategies for the strategy concept."},"759":{"id":"/docs/explanation/pipeline-11","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"The validation loop is a key differentiator. Every LLM response is validated against the schema using Ajv **before** the strategy considers it done. If validation fails, the errors are serialized and sent back to the model as a follow-up message."},"760":{"id":"/docs/explanation/pipeline-12","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"**Smart validation**: For multi-step strategies (parallel, sequential, double-pass), Struktur uses lenient validation during intermediate steps—required field violations are allowed until the final step. This prevents false failures when data is split across chunks. Use the `strict` option to disable this behavior."},"761":{"id":"/docs/explanation/pipeline-13","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Most extractions converge within two attempts. This happens **inside** the strategy, not as a post-processing step."},"762":{"id":"/docs/explanation/pipeline-14","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Default: `maxAttempts` = 3."},"763":{"id":"/docs/explanation/pipeline-15","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"See Validation & Retries for the validation concept."},"764":{"id":"/docs/explanation/pipeline-16","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"The extraction result has three fields:"},"765":{"id":"/docs/explanation/pipeline-17","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Field"},"766":{"id":"/docs/explanation/pipeline-18","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Description"},"767":{"id":"/docs/explanation/pipeline-19","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`data`"},"768":{"id":"/docs/explanation/pipeline-20","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Validated output matching your schema. If `error` is set, may not be trustworthy."},"769":{"id":"/docs/explanation/pipeline-21","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`usage`"},"770":{"id":"/docs/explanation/pipeline-22","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Aggregated token counts across all LLM calls."},"771":{"id":"/docs/explanation/pipeline-23","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`error`"},"772":{"id":"/docs/explanation/pipeline-24","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Set if extraction encountered a non-fatal error."},"773":{"id":"/docs/explanation/pipeline-25","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Parsers — how files are converted to artifacts"},"774":{"id":"/docs/explanation/pipeline-26","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Artifacts — the input format"},"775":{"id":"/docs/explanation/pipeline-27","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Strategies — orchestration patterns"},"776":{"id":"/docs/explanation/pipeline-28","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Chunking & Token Budgets — how large documents are split"},"777":{"id":"/docs/explanation/pipeline-29","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Validation & Retries — the retry loop"},"778":{"id":"/docs/explanation/preprocessing/artifact-format","page_id":"/docs/explanation/preprocessing/artifact-format","type":"page","content":"Artifact Format","breadcrumbs":["Struktur","Concepts","Document Processing"],"tags":[],"url":"/docs/explanation/preprocessing/artifact-format"},"779":{"id":"/docs/explanation/preprocessing/artifact-format-0","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format","content":"The artifact abstraction and complete specification."},"780":{"id":"/docs/explanation/preprocessing/artifact-format-1","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#the-normalization-boundary","content":"The normalization boundary"},"781":{"id":"/docs/explanation/preprocessing/artifact-format-2","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#what-an-artifact-contains","content":"What an artifact contains"},"782":{"id":"/docs/explanation/preprocessin