ers-add","content":"<TypeTable\n  type=\"{\n  token: {\n    description: 'API token value (avoid — token may appear in shell history)',\n    type: 'string',\n    required: false,\n  },\n  'token-stdin': {\n    description: 'Read token from stdin (recommended)',\n    type: 'boolean',\n    required: false,\n  },\n  storage: {\n    description: 'Storage mode for the token',\n    type: '&#x22;auto&#x22; | &#x22;keychain&#x22; | &#x22;file&#x22;',\n    default: 'auto',\n    required: false,\n  },\n  default: {\n    description: 'After storing, query the API for cheapest model and set as default',\n    type: 'boolean',\n    required: false,\n  },\n}\"\n/>"},"25":{"id":"/docs/cli/config-23","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"Output (without `--default`): `{ \"provider\": \"openai\", \"stored\": \"keychain\" }`"},"26":{"id":"/docs/cli/config-24","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"Output (with `--default`): `{ \"provider\": \"openai\", \"stored\": \"keychain\", \"defaultModel\": \"openai/gpt-4.1-nano\" }`"},"27":{"id":"/docs/cli/config-25","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"**Storage:** On macOS, tokens go into Keychain by default. On other platforms, `~/.config/struktur/tokens.json` (chmod 600). Set `STRUKTUR_DISABLE_KEYCHAIN` to force file storage on macOS."},"28":{"id":"/docs/cli/config-26","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-remove","content":"Delete a stored token."},"29":{"id":"/docs/cli/config-27","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-remove","content":"Output: `{ \"provider\": \"openai\", \"deleted\": true }`"},"30":{"id":"/docs/cli/config-28","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models","content":"Manage the default model and model aliases."},"31":{"id":"/docs/cli/config-29","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models-list","content":"List available models for a provider (queries the provider API)."},"32":{"id":"/docs/cli/config-30","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models-use","content":"Set the default model. Accepts a `provider/model` spec or a stored alias."},"33":{"id":"/docs/cli/config-31","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models-use","content":"The alias is resolved before storing, so config always holds a real model string."},"34":{"id":"/docs/cli/config-32","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models-alias","content":"Manage short aliases for model specs. Aliases resolve transparently everywhere a model is accepted — `--model fast` works identically to `--model openai/gpt-4.1-mini`."},"35":{"id":"/docs/cli/config-33","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-models-alias","content":"`alias list` output:"},"36":{"id":"/docs/cli/config-34","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-parsers","content":"Register custom parsers for file formats not supported natively. Parsers are keyed by MIME type."},"37":{"id":"/docs/cli/config-35","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-parsers-add","content":"<TypeTable\n  type=\"{\n  mime: {\n    description: 'MIME type to handle (e.g. application/vnd.ms-excel)',\n    type: 'string',\n    required: true,\n  },\n  npm: {\n    description: 'npm package name implementing the parser contract',\n    type: 'string',\n    required: false,\n  },\n  'file-command': {\n    description: 'Shell command with FILE_PATH placeholder (replaced with the actual file path at runtime)',\n    type: 'string',\n   