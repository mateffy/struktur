ption."},"884":{"id":"/docs/explanation/models-and-providers-84","page_id":"/docs/explanation/models-and-providers","tags":[],"type":"text","url":"/docs/explanation/models-and-providers#listing-available-models","content":"The CLI can list available models from configured providers:"},"885":{"id":"/docs/explanation/models-and-providers-85","page_id":"/docs/explanation/models-and-providers","tags":[],"type":"text","url":"/docs/explanation/models-and-providers#see-also","content":"Extraction Strategies — How strategies use models"},"886":{"id":"/docs/explanation/models-and-providers-86","page_id":"/docs/explanation/models-and-providers","tags":[],"type":"text","url":"/docs/explanation/models-and-providers#see-also","content":"CLI Authentication — Managing provider tokens"},"887":{"id":"/docs/explanation/models-and-providers-87","page_id":"/docs/explanation/models-and-providers","tags":[],"type":"text","url":"/docs/explanation/models-and-providers#see-also","content":"Vercel AI SDK Documentation — Full provider documentation"},"888":{"id":"/docs/explanation/pipeline","page_id":"/docs/explanation/pipeline","type":"page","content":"Extraction Lifecycle","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/pipeline"},"889":{"id":"/docs/explanation/pipeline-0","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline","content":"How data flows through Struktur from input to output."},"890":{"id":"/docs/explanation/pipeline-1","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Inputs and Artifacts"},"891":{"id":"/docs/explanation/pipeline-2","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-strategy-layer","content":"The Strategy layer"},"892":{"id":"/docs/explanation/pipeline-3","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Validation inside the loop"},"893":{"id":"/docs/explanation/pipeline-4","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-result","content":"The result"},"894":{"id":"/docs/explanation/pipeline-5","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#see-also","content":"See also"},"895":{"id":"/docs/explanation/pipeline-6","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Struktur converts input files into **Artifacts** before extraction. For plain text or stdin, this is trivial. For structured files (PDFs, Office documents), Struktur runs a parser — built-in or custom — that extracts text and images per-page."},"896":{"id":"/docs/explanation/pipeline-7","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"<Card title=\"Document Parsing\" description=\"Learn how files are converted to artifacts\" href=\"/docs/explanation/document-parsing\" />"},"897":{"id":"/docs/explanation/pipeline-8","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"<Card title=\"Artifact Format\" description=\"Understand the artifact data structure\" href=\"/docs/explanation/artifact-format\" />"},"898":{"id":"/docs/explanation/pipeline-9","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"A strategy is the orchestration engine. It decides how to split the input, how many LLM calls to make, whether to run them concurrently or sequentially, and how to combine results."},"899":{"id":"/docs/explanation/pipeline-10","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"Built-in strategies cover the common patterns. You can also write your own."},"900":{"id":"/docs/explanation/pipeline-11","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"See Strategies for the complete strategy reference."},"901":{"id":"/docs/explanation/pipeline-12","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"The validation loop is a key differentiator. Every LLM response is validated against the schema **before** the strategy considers it done. If validation fails, the errors are serialized and sent back to the model as a follow-up message."},"902":{"id":"/docs/explanation/pipeline-13","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"**Smart validation**: For multi-step strategies (parallel, sequential, double-pass), Struktur uses lenient validation during intermediate steps—required field violations are allowed until the final step. This prevents false failures when data is split across chunks. Use the `strict` option to disable this behavior."},"903":{"id":"/docs/explanation/pipeline-14","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Most extractions converge within two attempts. This happens **inside** the strategy, not as a post-processing step."},"904":{"id":"/docs/explanation/pipeline-15","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Default: `maxAttempts` = 3."},"905":{"id":"/docs/explanation/pipeline-16","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"See Validation & Retries for the validation concept."},"906":{"id":"/docs/explanation/pipeline-17","page_i