tegies/double-pass-81","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#see-also","content":"doublePassAutoMerge — for array extraction"},"1223":{"id":"/docs/explanation/strategies/double-pass-82","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#see-also","content":"parallel — for speed priority"},"1224":{"id":"/docs/explanation/strategies/double-pass-83","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#see-also","content":"sequential — for single-pass sequential"},"1225":{"id":"/docs/explanation/strategies/double-pass-84","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#see-also","content":"Choosing a Strategy — decision guide"},"1226":{"id":"/docs/explanation/strategies","page_id":"/docs/explanation/strategies","type":"page","content":"Struktur","breadcrumbs":["Struktur","Concepts","Extraction Strategies"],"tags":[],"url":"/docs/explanation/strategies"},"1227":{"id":"/docs/explanation/strategies-0","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies","content":"The design philosophy, trade-offs, and extraction strategies behind Struktur."},"1228":{"id":"/docs/explanation/strategies-1","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-struktur","content":"Why Struktur?"},"1229":{"id":"/docs/explanation/strategies-2","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-not-managed-apis","content":"Why not managed APIs?"},"1230":{"id":"/docs/explanation/strategies-3","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"Why not a plain LLM SDK call?"},"1231":{"id":"/docs/explanation/strategies-4","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#design-philosophy","content":"Design philosophy"},"1232":{"id":"/docs/explanation/strategies-5","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#trade-offs","content":"Trade-offs"},"1233":{"id":"/docs/explanation/strategies-6","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#what-are-strategies","content":"What are Strategies?"},"1234":{"id":"/docs/explanation/strategies-7","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#built-in-strategies","content":"Built-in strategies"},"1235":{"id":"/docs/explanation/strategies-8","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#choosing-a-strategy","content":"Choosing a strategy"},"1236":{"id":"/docs/explanation/strategies-9","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#custom-strategies","content":"Custom strategies"},"1237":{"id":"/docs/explanation/strategies-10","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#see-also","content":"See also"},"1238":{"id":"/docs/explanation/strategies-11","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Large document batches arrive with data locked in semi-structured text. Invoices need to flow into spreadsheets. Product datasheets need to become database rows. The tooling exists, but the orchestration overhead is disproportionate to the extraction task itself."},"1239":{"id":"/docs/explanation/strategies-12","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Managed APIs charge per page, impose schema constraints, and require document uploads to external infrastructure. LLM SDKs provide raw model access but leave you to write chunking, validation, retries, and merging every time."},"1240":{"id":"/docs/explanation/strategies-13","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Struktur fills the gap: a focused extraction engine that handles the orchestration so you can focus on the output."},"1241":{"id":"/docs/explanation/strategies-14","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Limitation"},"1242":{"id":"/docs/explanation/strategies-15","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Impact"},"1243":{"id":"/docs/explanation/strategies-16","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Per-page pricing"},"1244":{"id":"/docs/explanation/strategies-17","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Does not scale for large batches"},"1245":{"id":"/docs/explanation/strategies-18","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Schema constraints"},"1246":{"id":"/docs/explanation/strategies-19","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"You work within their data model"},"1247":{"id":"/docs/explanation/strategies-20","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Document upload"},"1248":{"id":"/docs/explanation/strategies-21","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Non-starter for confidential workloads"},"1249":{"id":"/docs/explanation/strategies-22","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Black-box behavior"},"1250":{"id":"/docs/explanation/strategies-23","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Debugging extraction failures is opaque"},"1251":{"id":"/docs/explanation/strategies-24","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"A single `generateText()` call gives you:"},"1252":{"id":"/docs/explanation/strategies-25","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No chunking for large documents"},"1253":{"id":"/docs/explanation/strategies-26","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No retries on schema validation failure"},"1254":{"id":"/docs/explanation/strategies-27","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No merging of multi-chunk results"},"1255":{"id":"/docs/explanation/strategies-28","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No typed output inferred from your schema"},"1256":{"id":"/docs/explanation/strategies-29","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"You write the same orchestration boilerplate every time. Struktur packages that orchestration into tested, configurable strategies."},"1257":{"id":"/docs/explanation/strategies-30","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Narrow scope, intentionally.** Struktur does extraction only. No parsing. No streaming. No general-purpose LLM orchestration. This focus keeps the API small and the behavior predictable."},"1258":{"id":"/docs/explanation/strategies-31","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Shell-composable by default.** Reads stdin, writes stdout, speaks JSON. Integrates with `jq`, `find`, `curl`, and any tool in your pipeline."},"1259":{"id":"/docs/explanation/strategies-32","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Strategy-first.** Different documents need different approaches. A single-page invoice needs simple extraction. A 100-page catalog with duplicate products needs parallel extraction with deduplication. Strategies encode these patterns."},"1260":{"id":"/docs/explanation/strategies-33","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Validation in the loop.** Errors go back to the model, not to you. The retry loop means most extractions converge within two attempts."},"1261":{"id":"/docs/explanation/strategies-34","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Trade-off"},"1262":{"id":"/docs/explanation/strategies-35","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Rationale"},"1263":{"id":"/docs/explanation/strategies-36","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Requires upstream preprocessing"},"1264":{"id":"/docs/explanation/strategies-37","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Keeps Struktur focused; use best-of-breed parsers per format"},"1265":{"id":"/docs/explanation/strategies-38","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Batch-only, no streaming"},"1266":{"id":"/docs/explanation/strategies-39","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Simpler mental model; input in, JSON out"},"1267":{"id":"/docs/explanation/strategies-40","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Depends on Vercel AI SDK providers"},"1268":{"id":"/docs/explanation/strategies-41","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"OpenAI, Anthropic, Google supported; self-hosted models need OpenAI-compatible API"},"1269":{"id":"/docs/explanation/strategies-42","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Token costs depend on strategy"},"1270":{"id":"/docs/explanation/strategies-43","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"`doublePass` costs more than `simple`; know your rates"},"1271":{"id":"/docs/explanation/strategies-44","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"A strategy implements:"},"1272":{"id":"/docs/explanation/strategies-45","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"