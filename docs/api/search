parsing#urltoartifacturl","content":"`urlToArtifact(url)`"},"535":{"id":"/docs/explanation/document-parsing-25","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#see-also","content":"See also"},"536":{"id":"/docs/explanation/document-parsing-26","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"537":{"id":"/docs/explanation/document-parsing-27","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"538":{"id":"/docs/explanation/document-parsing-28","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"539":{"id":"/docs/explanation/document-parsing-29","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**npm `detectFileType` callback**: A custom npm parser may export a `detectFileType(header: Uint8Array): boolean` function to claim MIME types beyond what magic bytes cover."},"540":{"id":"/docs/explanation/document-parsing-30","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"541":{"id":"/docs/explanation/document-parsing-31","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"542":{"id":"/docs/explanation/document-parsing-32","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"MIME type"},"543":{"id":"/docs/explanation/document-parsing-33","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Behavior"},"544":{"id":"/docs/explanation/document-parsing-34","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/pdf`"},"545":{"id":"/docs/explanation/document-parsing-35","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Per-page text via `pdf-parse`. Embedded images require `--images`. Page screenshots require `--screenshots`. Image deduplication filters images smaller than \\~80px. Non-fatal on image/screenshot failures."},"546":{"id":"/docs/explanation/document-parsing-36","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`text/*`"},"547":{"id":"/docs/explanation/document-parsing-37","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Split on double newlines into content slices."},"548":{"id":"/docs/explanation/document-parsing-38","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`image/*`"},"549":{"id":"/docs/explanation/document-parsing-39","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Single-content artifact with one media item."},"550":{"id":"/docs/explanation/document-parsing-40","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/json`"},"551":{"id":"/docs/explanation/document-parsing-41","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"If it validates as `SerializedArtifact[]`, passed through unchanged without invoking any parser."},"552":{"id":"/docs/explanation/document-parsing-42","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Flag"},"553":{"id":"/docs/explanation/document-parsing-43","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Description"},"554":{"id":"/docs/explanation/document-parsing-44","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"`--stdin`"},"555":{"id":"/docs/explanation/document-parsing-45","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Reads stdin as UTF-8 text. Auto-detected when piped with no other input flag."},"556":{"id":"/docs/explanation/document-parsing-46","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"`--text <string>`"},"557":{"id":"/docs/explanation/document-parsing-47","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Inline text as a CLI argument."},"558":{"id":"/docs/explanation/document-parsing-48","page_id":"/docs/explana