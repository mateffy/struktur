explanation/strategies/double-pass#see-also","content":"Choosing a Strategy — decision guide"},"979":{"id":"/docs/explanation/strategies","page_id":"/docs/explanation/strategies","type":"page","content":"Struktur","breadcrumbs":["Struktur","Concepts","Extraction Strategies"],"tags":[],"url":"/docs/explanation/strategies"},"980":{"id":"/docs/explanation/strategies-0","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies","content":"The design philosophy, trade-offs, and extraction strategies behind Struktur."},"981":{"id":"/docs/explanation/strategies-1","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-struktur","content":"Why Struktur?"},"982":{"id":"/docs/explanation/strategies-2","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-not-managed-apis","content":"Why not managed APIs?"},"983":{"id":"/docs/explanation/strategies-3","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"Why not a plain LLM SDK call?"},"984":{"id":"/docs/explanation/strategies-4","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#design-philosophy","content":"Design philosophy"},"985":{"id":"/docs/explanation/strategies-5","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#trade-offs","content":"Trade-offs"},"986":{"id":"/docs/explanation/strategies-6","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#what-are-strategies","content":"What are Strategies?"},"987":{"id":"/docs/explanation/strategies-7","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#built-in-strategies","content":"Built-in strategies"},"988":{"id":"/docs/explanation/strategies-8","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#choosing-a-strategy","content":"Choosing a strategy"},"989":{"id":"/docs/explanation/strategies-9","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#custom-strategies","content":"Custom strategies"},"990":{"id":"/docs/explanation/strategies-10","page_id":"/docs/explanation/strategies","type":"heading","tags":[],"url":"/docs/explanation/strategies#see-also","content":"See also"},"991":{"id":"/docs/explanation/strategies-11","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Large document batches arrive with data locked in semi-structured text. Invoices need to flow into spreadsheets. Product datasheets need to become database rows. The tooling exists, but the orchestration overhead is disproportionate to the extraction task itself."},"992":{"id":"/docs/explanation/strategies-12","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Managed APIs charge per page, impose schema constraints, and require document uploads to external infrastructure. LLM SDKs provide raw model access but leave you to write chunking, validation, retries, and merging every time."},"993":{"id":"/docs/explanation/strategies-13","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-struktur","content":"Struktur fills the gap: a focused extraction engine that handles the orchestration so you can focus on the output."},"994":{"id":"/docs/explanation/strategies-14","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Limitation"},"995":{"id":"/docs/explanation/strategies-15","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Impact"},"996":{"id":"/docs/explanation/strategies-16","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Per-page pricing"},"997":{"id":"/docs/explanation/strategies-17","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Does not scale for large batches"},"998":{"id":"/docs/explanation/strategies-18","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Schema constraints"},"999":{"id":"/docs/explanation/strategies-19","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"You work within their data model"},"1000":{"id":"/docs/explanation/strategies-20","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Document upload"},"1001":{"id":"/docs/explanation/strategies-21","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Non-starter for confidential workloads"},"1002":{"id":"/docs/explanation/strategies-22","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Black-box behavior"},"1003":{"id":"/docs/explanation/strategies-23","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-managed-apis","content":"Debugging extraction failures is opaque"},"1004":{"id":"/docs/explanation/strategies-24","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"A single `generateText()` call gives you:"},"1005":{"id":"/docs/explanation/strategies-25","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No chunking for large documents"},"1006":{"id":"/docs/explanation/strategies-26","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No retries on schema validation failure"},"1007":{"id":"/docs/explanation/strategies-27","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No merging of multi-chunk results"},"1008":{"id":"/docs/explanation/strategies-28","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"No typed output inferred from your schema"},"1009":{"id":"/docs/explanation/strategies-29","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#why-not-a-plain-llm-sdk-call","content":"You write the same orchestration boilerplate every time. Struktur packages that orchestration into tested, configurable strategies."},"1010":{"id":"/docs/explanation/strategies-30","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Narrow scope, intentionally.** Struktur does extraction only. No parsing. No streaming. No general-purpose LLM orchestration. This focus keeps the API small and the behavior predictable."},"1011":{"id":"/docs/explanation/strategies-31","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Shell-composable by default.** Reads stdin, writes stdout, speaks JSON. Integrates with `jq`, `find`, `curl`, and any tool in your pipeline."},"1012":{"id":"/docs/explanation/strategies-32","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Strategy-first.** Different documents need different approaches. A single-page invoice needs simple extraction. A 100-page catalog with duplicate products needs parallel extraction with deduplication. Strategies encode these patterns."},"1013":{"id":"/docs/explanation/strategies-33","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#design-philosophy","content":"**Validation in the loop.** Errors go back to the model, not to you. The retry loop means most extractions converge within two attempts."},"1014":{"id":"/docs/explanation/strategies-34","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Trade-off"},"1015":{"id":"/docs/explanation/strategies-35","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Rationale"},"1016":{"id":"/docs/explanation/strategies-36","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Requires upstream preprocessing"},"1017":{"id":"/docs/explanation/strategies-37","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Keeps Struktur focused; use best-of-breed parsers per format"},"1018":{"id":"/docs/explanation/strategies-38","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Batch-only, no streaming"},"1019":{"id":"/docs/explanation/strategies-39","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Simpler mental model; input in, JSON out"},"1020":{"id":"/docs/explanation/strategies-40","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Depends on Vercel AI SDK providers"},"1021":{"id":"/docs/explanation/strategies-41","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"OpenAI, Anthropic, Google supported; self-hosted models need OpenAI-compatible API"},"1022":{"id":"/docs/explanation/strategies-42","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"Token costs depend on strategy"},"1023":{"id":"/docs/explanation/strategies-43","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#trade-offs","content":"`doublePass` costs more than `simple`; know your rates"},"1024":{"id":"/docs/explanation/strategies-44","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"A strategy implements:"},"1025":{"id":"/docs/explanation/strategies-45","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"`name`: string identifier"},"1026":{"id":"/docs/explanation/strategies-46","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"`run()`: the orchestration logic"},"1027":{"id":"/docs/explanation/strategies-47","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"`getEstimatedSteps()`: optional, for progress tracking"},"1028":{"id":"/docs/explanation/strategies-48","page_id":"/docs/explanation/strategies","tags":[],"type":"text","url":"/docs/explanation/strategies#what-are-strategies","content":"Strategies own their config (model, chunk size, concurrency). All strategies guarantee: output validates against the schema or they throw."},"1029":{"id":"/docs/explanation/strategies-49","page_id":"/docs/exp