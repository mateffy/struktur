{
  "name": "struktur-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run --filter '@struktur/sdk' --filter '@struktur/telemetry' --filter '@struktur/cli' build",
    "docs": "bun run docs:build && bun run docs:publish",
    "docs:build": "bun run --filter @struktur/documentation build",
    "docs:publish": "git add ./docs ./packages/documentation && git commit -m 'chore: update docs' && git push",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:major": "bun scripts/version.ts major",
    "publish": "bun scripts/publish.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.57.1",
    "@radix-ui/react-separator": "^1.1.8",
    "@sinclair/typebox": "^0.34.48"
  }
}
