{
  "name": "@struktur/benchmarks",
  "version": "0.1.0",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./datasets": {
      "types": "./dist/datasets/index.d.ts",
      "import": "./dist/datasets/index.js"
    }
  },
  "bin": {
    "struktur-benchmarks": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@struktur/sdk": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.0",
    "zod": "^4.4.3"
  }
