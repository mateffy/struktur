{
  "name": "@struktur/cli",
  "version": "2.6.1",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "bin": {
    "struktur": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:binary": "bun build --compile ./dist/cli.js --outfile dist/struktur --external '@mongodb-js/zstd' --external '@langfuse/otel' --external '@langfuse/core'",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@kreuzberg/node": "^4",
    "@llamaindex/liteparse": "^1",
    "@struktur/processors": "workspace:*",
    "@struktur/sdk": "workspace:*",
    "@struktur/telemetry": "workspace:*",
    "citty": "^0.2.1",
    "kleur": "^4.1.5",
    "pdf-parse": "^2.4.5",
    "yocto-spinner": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.0"
  }
}
