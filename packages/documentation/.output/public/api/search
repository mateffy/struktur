anation/document-parsing-19","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parser-resolution-order","content":"Parser Resolution Order"},"619":{"id":"/docs/explanation/document-parsing-20","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#ad-hoc-parser-override","content":"Ad-hoc Parser Override"},"620":{"id":"/docs/explanation/document-parsing-21","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#sdk-usage","content":"SDK Usage"},"621":{"id":"/docs/explanation/document-parsing-22","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parseinput-options","content":"`parse(input, options?)`"},"622":{"id":"/docs/explanation/document-parsing-23","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#filetoartifactbuffer-options","content":"`fileToArtifact(buffer, options)`"},"623":{"id":"/docs/explanation/document-parsing-24","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#urltoartifacturl","content":"`urlToArtifact(url)`"},"624":{"id":"/docs/explanation/document-parsing-25","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#see-also","content":"See also"},"625":{"id":"/docs/explanation/document-parsing-26","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"626":{"id":"/docs/explanation/document-parsing-27","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"627":{"id":"/docs/explanation/document-parsing-28","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"628":{"id":"/docs/explanation/document-parsing-29","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**npm `detectFileType` callback**: A custom npm parser may export a `detectFileType(header: Uint8Array): boolean` function to claim MIME types beyond what magic bytes cover."},"629":{"id":"/docs/explanation/document-parsing-30","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"630":{"id":"/docs/explanation/document-parsing-31","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"631":{"id":"/docs/explanation/document-parsing-32","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"MIME type"},"632":{"id":"/docs/explanation/document-parsing-33","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Behavior"},"633":{"id":"/docs/explanation/document-parsing-34","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/pdf`"},"634":{"id":"/docs/explanation/document-parsing-35","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Per-page text via `pdf-parse`. Embedded images require `--images`. Page screenshots require `--screenshots`. Image deduplication filters images smaller than \\~80px. Non-fatal on image/screenshot failures."},"635":{"id":"/docs/explanation/document-parsing-36","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`text/*`"},"636":{"id":"/docs/explanation/document-parsing-37","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Split on double newlines into content slices."},"637":{"id":"/docs/explanation/document-parsing-38","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`image/*`"},"638":{"id":"/docs/explanation/document-parsing-39","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"Single-content artifact with one media item."},"639":{"id":"/docs/explanation/document-parsing-40","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"`application/json`"},"640":{"id":"/docs/explanation/document-parsing-41","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"If it validates as `SerializedArtifact[]`, passed through unchanged without invoking any parser."},"641":{"id":"/docs/explanation/document-parsing-42","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#plain-text--markdown-