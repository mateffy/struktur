tags":[],"url":"/docs/explanation/document-parsing#sdk-usage","content":"SDK Usage"},"542":{"id":"/docs/explanation/document-parsing-22","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parseinput-options","content":"`parse(input, options?)`"},"543":{"id":"/docs/explanation/document-parsing-23","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#filetoartifactbuffer-options","content":"`fileToArtifact(buffer, options)`"},"544":{"id":"/docs/explanation/document-parsing-24","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#urltoartifacturl","content":"`urlToArtifact(url)`"},"545":{"id":"/docs/explanation/document-parsing-25","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#see-also","content":"See also"},"546":{"id":"/docs/explanation/document-parsing-26","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"547":{"id":"/docs/explanation/document-parsing-27","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"548":{"id":"/docs/explanation/document-parsing-28","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"549":{"id":"/docs/explanation/document-parsing-29","page_id":"/docs/explanation/document-parsing","t