n/preprocessing/artifact-format#why-text--images-together","content":"Why text + images together?"},"786":{"id":"/docs/explanation/preprocessing/artifact-format-4","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#complete-specification","content":"Complete specification"},"787":{"id":"/docs/explanation/preprocessing/artifact-format-5","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#top-level-shape","content":"Top-level shape"},"788":{"id":"/docs/explanation/preprocessing/artifact-format-6","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#content-slices","content":"Content slices"},"789":{"id":"/docs/explanation/preprocessing/artifact-format-7","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#images","content":"Images"},"790":{"id":"/docs/explanation/preprocessing/artifact-format-8","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#complete-example","content":"Complete example"},"791":{"id":"/docs/explanation/preprocessing/artifact-format-9","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#validation","content":"Validation"},"792":{"id":"/docs/explanation/preprocessing/artifact-format-10","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#built-in-artifact-creation","content":"Built-in artifact creation"},"793":{"id":"/docs/explanation/preprocessing/artifact-format-11","page_id":"/docs/explanation/preprocessing/artifact-format","type":"heading","tags":[],"url":"/docs/explanation/preprocessing/artifact-format#see-also","content":"See also"},"794":{"id":"/docs/explanation/preprocessing/artifact-format-12","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#the-normalization-boundary","content":"Different document types (PDF, HTML, Excel, email) require different parsing strategies. But LLM extraction is the same regardless of source format. The Artifact is the normalized form that crosses that boundary."},"795":{"id":"/docs/explanation/preprocessing/artifact-format-13","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#the-normalization-boundary","content":"Struktur only cares about what is in the artifact, not where it came from."},"796":{"id":"/docs/explanation/preprocessing/artifact-format-14","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#what-an-artifact-contains","content":"An artifact has:"},"797":{"id":"/docs/explanation/preprocessing/artifact-format-15","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#what-an-artifact-contains","content":"`id`: unique identifier"},"798":{"id":"/docs/explanation/preprocessing/artifact-format-16","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#what-an-artifact-contains","content":"`type`: type hint (`text`, `image`, `pdf`, `file`)"},"799":{"id":"/docs/explanation/preprocessing/artifact-format-17","page_id":"/docs/explanation/preprocessing/artifact-format","tags":[],"type":"text","url":"/docs/explanation/preprocessing/artifact-format#what-an-artifact-contains","content":"`contents`: a sequence of content slices"},"