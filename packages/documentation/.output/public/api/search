/config-18","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers","content":"Manage API tokens for LLM providers."},"21":{"id":"/docs/cli/config-19","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-list","content":"List all supported providers with their configuration status."},"22":{"id":"/docs/cli/config-20","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-list","content":"Output:"},"23":{"id":"/docs/cli/config-21","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"Store an API token for a provider."},"24":{"id":"/docs/cli/config-22","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"<TypeTable\n  type=\"{\n  token: {\n    description: 'API token value (avoid — token may appear in shell history)',\n    type: 'string',\n    required: false,\n  },\n  'token-stdin': {\n    description: 'Read token from stdin (recommended)',\n    type: 'boolean',\n    required: false,\n  },\n  storage: {\n    description: 'Storage mode for the token',\n    type: '&#x22;auto&#x22; | &#x22;keychain&#x22; | &#x22;file&#x22;',\n    default: 'auto',\n    required: false,\n  },\n  default: {\n    description: 'After storing, query the API for cheapest model and set as default',\n    type: 'boolean',\n    required: false,\n  },\n}\"\n/>"},"25":{"id":"/docs/cli/config-23","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"Output (without `--default`): `{ \"provider\": \"openai\", \"stored\": \"keychain\" }`"},"26":{"id":"/docs/cli/config-24","page_id":"/docs/cli/config","tags":[],"type":"text","url":"/docs/cli/config#config-providers-add","content":"Output (with `--default`): `{ \"provider\": \"openai\", \"stored\": \"keychain\", \"defaultModel\": \"openai/gpt-4.1-nano\" }`"},"27":{"id":"/d