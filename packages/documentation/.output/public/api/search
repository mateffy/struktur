cs/examples/watch-folder-8","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#linux-inotifywait","content":"For formats without a built-in parser, pipe through a conversion tool first:"},"644":{"id":"/docs/examples/watch-folder-9","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#output-to-jsonl","content":"For streaming ingestion, append to a JSONL file (one JSON object per line):"},"645":{"id":"/docs/examples/watch-folder-10","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#sdk-chokidar","content":"For more robust file watching:"},"646":{"id":"/docs/examples/watch-folder-11","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#see-also","content":"Process a Directory of Files — batch processing"},"647":{"id":"/docs/examples/watch-folder-12","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#see-also","content":"Shell Pipelines & Patterns — more shell patterns"},"648":{"id":"/docs/examples/watch-folder-13","page_id":"/docs/examples/watch-folder","tags":[],"type":"text","url":"/docs/examples/watch-folder#see-also","content":"simple — single-shot extraction"},"649":{"id":"/docs/explanation/chunking","page_id":"/docs/explanation/chunking","type":"page","content":"Chunking & Token Budgets","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/chunking"},"650":{"id":"/docs/explanation/chunking-0","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking","content":"How large documents are split and merged to fit within context windows."},"651":{"id":"/docs/explanation/chunking-1","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#the-context-window-problem","content":"The context window problem"},"652":{"id":"/docs/explanation/chunking-2","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#how-splitting-works","content":"How splitting works"},"653":{"id":"/docs/explanation/chunking-3","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#images-and-maximages","content":"Images and `maxImages`"},"654":{"id":"/docs/explanation/chunking-4","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"Why `simple` does not chunk"},"655":{"id":"/docs/explanation/chunking-5","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#merging-partial-results","content":"Merging partial results"},"656":{"id":"/docs/explanation/chunking-6","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"LLM merge (parallel, doublePass)"},"657":{"id":"/docs/explanation/chunking-7","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"Schema-aware auto-merge"},"658":{"id":"/docs/explanation/chunking-8","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#deduplication","content":"Deduplication"},"659":{"id":"/docs/explanation/chunking-9","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#when-dedup-matters","content":"When dedup matters"},"660":{"id":"/docs/explanation/chunking-10","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#see-also","content":"See also"},"661":{"id":"/docs/explanation/chunking-11","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#the-context-window-problem","content":"LLMs have finite context windows. Documents — especially multi-page PDFs, large datasets, or many files at once — often exceed them. Struktur's chunker splits artifact contents into batches that fit within a configurable token budget (`chunkSize`)."},"662":{"id":"/docs/explanation/chunking-12","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"Splitting happens at two levels:"},"663":{"id":"/docs/explanation/chunking-13","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactSplitter:** splits a single large artifact's contents into smaller parts, respecting content slice boundaries (e.g., page boundaries)."},"664":{"id":"/docs/explanation/chunking-14","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactBatcher:** groups artifacts or artifact parts into batches that stay within the token budget and optional image count limit."},"665":{"id":"/docs/explanation/chunking-15","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"The tokenizer uses a character-approximation (not exact token counting). `chunkSize` defaults to 10,000 tokens."},"666":{"id":"/docs/explanation/chunking-16","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#images-and-maximages","content":"Some strategies accept `maxImages` to cap how many images appear per chunk. This matters when images consume disproportionate context. If a batch would exceed `maxImages`, extra images are moved to the next batch."},"667":{"id":"/docs/explanation/chunking-17","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"The `simple` strategy loads all artifacts as-is. If the input exceeds the context window, the LLM call may fail or produce degraded results. For large inputs, use a chunked strategy."},"668":{"id":"/docs/explanation/chunking-18","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"This is a deliberate trade-off: `simple` is fast and cheap for small inputs, not suitable for large ones."},"669":{"id":"/docs/explanation/chunking-19","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"When a document is split into N chunks and each chunk is extracted independently, you get N partial objects."},"670":{"id":"/docs/explanation/chunking-20","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For a scalar-heavy schema (title, author, date), you want the best answer from all chunks."},"671":{"id":"/docs/explanation/chunking-21","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For an array-heavy schema (line items, product listings), you want to concatenate all arrays and remove duplicates."},"672":{"id":"/docs/explanation/chunking-22","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"These strategies send all partial results to a **merge model** in a single call, with a prompt asking it to produce a single coherent output. The merge model sees the full schema and all partial outputs."},"673":{"id":"/docs/explanation/chunking-23","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"This is powerful but costs extra tokens."},"674":{"id":"/docs/explanation/chunking-24","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"`parallelAutoMerge`, `sequentialAutoMerge`, and `doublePassAutoMerge` use `SmartDataMerger`:"},"675":{"id":"/docs/explanation/chunking-25","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Arrays:** concatenated. `items` from chunk 1 + `items` from chunk 2 = `items` in merged."},"676":{"id":"/docs/explanation/chunking-26","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Objects:** shallow-merged. Keys from later chunks overwrite keys from earlier ones."},"677":{"id":"/docs/explanation/chunking-27","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Scalars:** prefer newer non-empty values."},"678":{"id":"/docs/explanation/chunking-28","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"This approach avoids an extra LLM call and works well for list-extraction schemas. It does not handle complex cross-chunk synthesis — for that, use LLM merge."},"679":{"id":"/docs/explanation/chunking-29","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"After auto-merging concatenated arrays, there may be duplicates. Dedup runs in two stages:"},"680":{"id":"/docs/explanation/chunking-30","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 1: CRC32 hash-based.** Exact duplicates (byte-for-byte identical after stable JSON stringification) are removed without any LLM call. Fast and cheap."},"681":{"id":"/docs/explanation/chunking-31","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 2: LLM-based semantic dedup.** A dedupe model is given the merged array and asked to identify semantically equivalent entries (e.g., \"iPhone 15\" vs \"Apple iPhone 15 128GB\"). It returns a list of dot-path keys to remove (e.g., `items.3`)."},"682":{"id":"/docs/explanation/chunking-32","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"Only the auto-merge variants include this step."},"683":{"id":"/docs/explanation/chunking-33","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup is valuable when:"},"684":{"id":"/docs/explanation/chunking-34","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same item legitimately appears in multiple chunks."},"685":{"id":"/docs/explanation/chunking-35","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same document segment appears in multiple artifacts."},"686":{"id":"/docs/explanation/chunking-36","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup adds token cost and latency. For schemas without arrays, or for inputs with no expected overlap, use strategies without auto-merge."},"687":{"id":"/docs/explanation/chunking-37","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"The Extraction Pipeline — the full flow"},"688":{"id":"/docs/explanation/chunking-38","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"Strategies — which strategies use chunking"},"689":{"id":"/docs/explanation/chunking-39","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"parallel — chunked parallel extraction"},"690":{"id":"/docs/explanation/chunking-40","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"sequential — chunked sequential extraction"},"691":{"id":"/docs/explanation","page_id":"/docs/explanation","type":"page","content":"Explanation","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation"},"692":{"id":"/docs/explanation-0","page_id":"/docs/explanation","type":"heading","tags":[],"url":"/docs/explanation#topics","content":"Topics"},"693":{"id":"/docs/explanation-1","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation","content":"Deep dives into Struktur's architecture, strategies, and design decisions."},"694":{"id":"/docs/explanation-2","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation#topics","content":"pipeline — How data flows through Struktur"},"695":{"id":"/docs/explanation-3","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation#topics","content":"chunking — Token-aware document splitting"},"696":{"id":"/docs/explanation-4","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation#topics","content":"validation — Schema validation and retry logic"},"697":{"id":"/docs/explanation-5","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation#topics","content":"strategies — Extraction strategies overview"},"698":{"id":"/docs/explanation-6","page_id":"/docs/explanation","tags":[],"type":"text","url":"/docs/explanation#topics","content":"preprocessing — Input handling and artifact format"},"699":{"id":"/docs/explanation/parsers","page_id":"/docs/explanation/parsers","type":"page","content":"Parsers","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/parsers"},"700":{"id":"/docs/explanation/parsers-0","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers","content":"How Struktur converts files into Artifacts before extraction."},"701":{"id":"/docs/explanation/parsers-1","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#mime-detection","content":"MIME Detection"},"702":{"id":"/docs/explanation/parsers-2","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#built-in-parsers","content":"Built-in Parsers"},"703":{"id":"/docs/explanation/parsers-3","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#custom-parsers","content":"Custom Parsers"},"704":{"id":"/docs/explanation/parsers-4","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#npm-package-parser","content":"npm package parser"},"705":{"id":"/docs/explanation/parsers-5","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#shell-command-file-based","content":"Shell command (file-based)"},"706":{"id":"/docs/explanation/parsers-6","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#shell-command-stdin-based","content":"Shell command (stdin-based)"},"707":{"id":"/docs/explanation/parsers-7","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#inline-parser-sdk-only","content":"Inline parser (SDK only)"},"708":{"id":"/docs/explanation/parsers-8","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#parser-resolution-order","content":"Parser Resolution Order"},"709":{"id":"/docs/explanation/parsers-9","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#ad-hoc-parser-override","content":"Ad-hoc Parser Override"},"710":{"id":"/docs/explanation/parsers-10","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#sdk-usage","content":"SDK Usage"},"711":{"id":"/docs/explanation/parsers-11","page_id":"/docs/explanation/parsers","type":"heading","tags":[],"url":"/docs/explanation/parsers#see-also","content":"See also"},"712":{"id":"/docs/explanation/parsers-12","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"713":{"id":"/docs/explanation/parsers-13","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"714":{"id":"/docs/explanation/parsers-14","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"715":{"id":"/docs/explanation/parsers-15","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"**npm `detectFileType` callback**: A custom npm parser may export a `detectFileType(header: Uint8Array): boolean` function to claim MIME types beyond what magic bytes cover."},"716":{"id":"/docs/explanation/parsers-16","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"717":{"id":"/docs/explanation/parsers-17","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"718":{"id":"/docs/explanation/parsers-18","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"MIME type"},"719":{"id":"/docs/explanation/parsers-19","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Behavior"},"720":{"id":"/docs/explanation/parsers-20","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`application/pdf`"},"721":{"id":"/docs/explanation/parsers-21","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Per-page text via `pdf-parse`. Embedded images require `--images`. Page screenshots require `--screenshots`. Image deduplication filters images smaller than \\~80px. Non-fatal on image/screenshot failures."},"722":{"id":"/docs/explanation/parsers-22","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`text/*`"},"723":{"id":"/docs/explanation/parsers-23","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Split on double newlines into content slices."},"724":{"id":"/docs/explanation/parsers-24","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`image/*`"},"725":{"id":"/docs/explanation/parsers-25","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"Single-content artifact with one media item."},"726":{"id":"/docs/explanation/parsers-26","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"`application/json`"},"727":{"id":"/docs/explanation/parsers-27","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#built-in-parsers","content":"If it validates as `SerializedArtifact[]`, passed through unchanged without invoking any parser."},"728":{"id":"/docs/explanation/parsers-28","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#custom-parsers","content":"Four types are supported. Three are registered with `struktur config parsers add`, and one is for SDK-only use."},"729":{"id":"/docs/explanation/parsers-29","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#npm-package-parser","content":"Install a package that implements the `NpmParserModule` interface:"},"730":{"id":"/docs/explanation/parsers-30","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#npm-package-parser","content":"When both `parseFile` and `parseStream` are exported, Struktur prefers `parseFile` for file inputs (zero-copy) and `parseStream` for buffer or stdin inputs. A temp file is created as a fallback if needed."},"731":{"id":"/docs/explanation/parsers-31","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#npm-package-parser","content":"Register it:"},"732":{"id":"/docs/explanation/parsers-32","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-file-based","content":"The `FILE_PATH` placeholder is replaced with the actual file path at runtime. For buffer inputs, a temp file is created automatically."},"733":{"id":"/docs/explanation/parsers-33","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-file-based","content":"`FILE_PATH` must appear in the command string — an error is thrown if it is missing."},"734":{"id":"/docs/explanation/parsers-34","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-file-based","content":"The command must write `SerializedArtifact[]` JSON to stdout."},"735":{"id":"/docs/explanation/parsers-35","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-stdin-based","content":"File contents are piped to the command's stdin."},"736":{"id":"/docs/explanation/parsers-36","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#shell-command-stdin-based","content":"The command must write `SerializedArtifact[]` JSON to stdout. Plain text output will fail validation."},"737":{"id":"/docs/explanation/parsers-37","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#inline-parser-sdk-only","content":"For code-only parsers in the SDK, use `InlineParserDef`:"},"738":{"id":"/docs/explanation/parsers-38","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#inline-parser-sdk-only","content":"Inline parsers are the modern replacement for the deprecated `providers` registry."},"739":{"id":"/docs/explanation/parsers-39","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"For any input, parsers are resolved in this order:"},"740":{"id":"/docs/explanation/parsers-40","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"`--parser <pkg>` flag on the CLI — always wins, bypasses all config"},"741":{"id":"/docs/explanation/parsers-41","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Parser configured for the detected MIME type (`config parsers add`)"},"742":{"id":"/docs/explanation/parsers-42","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Built-in parser (PDF, text/\\*, image/\\*, JSON)"},"743":{"id":"/docs/explanation/parsers-43","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#parser-resolution-order","content":"Error with a suggestion to use `config parsers add`"},"744":{"id":"/docs/explanation/parsers-44","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#ad-hoc-parser-override","content":"Use `--parser` to override the configured parser for a single run without changing config:"},"745":{"id":"/docs/explanation/parsers-45","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#sdk-usage","content":"Pass a `parserConfig` to `parse` to use custom parsers without CLI config:"},"746":{"id":"/docs/explanation/parsers-46","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"config parsers — CLI commands for managing parsers"},"747":{"id":"/docs/explanation/parsers-47","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"parse — Convert files to artifact JSON"},"748":{"id":"/docs/explanation/parsers-48","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"Artifact Format — The output data structure"},"749":{"id":"/docs/explanation/parsers-49","page_id":"/docs/explanation/parsers","tags":[],"type":"text","url":"/docs/explanation/parsers#see-also","content":"Built-in Input Types — SDK input helpers"},"750":{"id":"/docs/explanation/pipeline","page_id":"/docs/explanation/pipeline","type":"page","content":"Extraction Lifecycle","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/pipeline"},"751":{"id":"/docs/explanation/pipeline-0","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline","content":"How data flows through Struktur from input to output."},"752":{"id":"/docs/explanation/pipeline-1","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Inputs and Artifacts"},"753":{"id":"/docs/explanation/pipeline-2","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-strategy-layer","content":"The Strategy layer"},"754":{"id":"/docs/explanation/pipeline-3","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Validation inside the loop"},"755":{"id":"/docs/explanation/pipeline-4","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#the-result","content":"The result"},"756":{"id":"/docs/explanation/pipeline-5","page_id":"/docs/explanation/pipeline","type":"heading","tags":[],"url":"/docs/explanation/pipeline#see-also","content":"See also"},"757":{"id":"/docs/explanation/pipeline-6","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"Struktur converts input files into **Artifacts** before extraction. For plain text or stdin, this is trivial. For structured files (PDFs, Office documents), Struktur runs a parser — built-in or custom — that extracts text and images per-page."},"758":{"id":"/docs/explanation/pipeline-7","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#inputs-and-artifacts","content":"See Parsers for how files are converted to artifacts.\nSee Artifact Format for the data structure."},"759":{"id":"/docs/explanation/pipeline-8","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"A strategy is the orchestration engine. It decides how to split the input, how many LLM calls to make, whether to run them concurrently or sequentially, and how to combine results."},"760":{"id":"/docs/explanation/pipeline-9","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"Built-in strategies cover the common patterns. You can also write your own."},"761":{"id":"/docs/explanation/pipeline-10","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-strategy-layer","content":"See Strategies for the strategy concept."},"762":{"id":"/docs/explanation/pipeline-11","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"The validation loop is a key differentiator. Every LLM response is validated against the schema using Ajv **before** the strategy considers it done. If validation fails, the errors are serialized and sent back to the model as a follow-up message."},"763":{"id":"/docs/explanation/pipeline-12","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"**Smart validation**: For multi-step strategies (parallel, sequential, double-pass), Struktur uses lenient validation during intermediate steps—required field violations are allowed until the final step. This prevents false failures when data is split across chunks. Use the `strict` option to disable this behavior."},"764":{"id":"/docs/explanation/pipeline-13","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Most extractions converge within two attempts. This happens **inside** the strategy, not as a post-processing step."},"765":{"id":"/docs/explanation/pipeline-14","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"Default: `maxAttempts` = 3."},"766":{"id":"/docs/explanation/pipeline-15","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#validation-inside-the-loop","content":"See Validation & Retries for the validation concept."},"767":{"id":"/docs/explanation/pipeline-16","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"The extraction result has three fields:"},"768":{"id":"/docs/explanation/pipeline-17","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Field"},"769":{"id":"/docs/explanation/pipeline-18","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Description"},"770":{"id":"/docs/explanation/pipeline-19","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`data`"},"771":{"id":"/docs/explanation/pipeline-20","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Validated output matching your schema. If `error` is set, may not be trustworthy."},"772":{"id":"/docs/explanation/pipeline-21","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`usage`"},"773":{"id":"/docs/explanation/pipeline-22","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Aggregated token counts across all LLM calls."},"774":{"id":"/docs/explanation/pipeline-23","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"`error`"},"775":{"id":"/docs/explanation/pipeline-24","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#the-result","content":"Set if extraction encountered a non-fatal error."},"776":{"id":"/docs/explanation/pipeline-25","page_id":"/docs/explanation/pipeline","tags":[],"type":"text","url":"/docs/explanation/pipeline#see-also","content":"Parsers — how files are converted to artifacts"},"777":{"id":"/docs/explanation/pipeline-26","page_id":"/docs/explanation/pipeline","tags":[],"typ