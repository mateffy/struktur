8":{"id":"/docs/explanation/strategies/double-pass-70","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#validation-behavior","content":"Each batch extraction (both passes) is validated with retry. The pass 1 merge is also validated."},"1219":{"id":"/docs/explanation/strategies/double-pass-71","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#merge-behavior","content":"**Pass 1:** LLM merge. All partial results sent to merge model."},"1220":{"id":"/docs/explanation/strategies/double-pass-72","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#merge-behavior","content":"**Pass 2:** Context carryover. Each batch sees previous pass 2 result as context."},"1221":{"id":"/docs/explanation/strategies/double-pass-73","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#token-cost-profile","content":"**High** — 2 × N extraction calls + 1 merge call. Highest cost strategy."},"1222":{"id":"/docs/explanation/strategies/double-pass-74","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#when-to-use","content":"Accuracy is more important than cost"},"1223":{"id":"/docs/explanation/strategies/double-pass-75","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#when-to-use","content":"High-stakes extractions"},"1224":{"id":"/docs/explanation/strategies/double-pass-76","page_id":"/docs/explanation/strategies/double-pass","tags":[],"type":"text","url":"/docs/explanation/strategies/double-pass#when-to-use","content":"Complex schemas"},"1225":{"id":"/docs/explanation/strategies/double-pass-77","page_id":"/docs/explanation/strategies/double-pass","tags":[