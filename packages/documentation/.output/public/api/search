nation/artifact-format#validation","content":"Struktur validates artifact JSON before processing. Use the CLI:"},"668":{"id":"/docs/explanation/artifact-format-84","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#validation","content":"Returns `{ \"valid\": true, \"artifacts\": 1 }` on success, throws with error detail on failure."},"669":{"id":"/docs/explanation/artifact-format-85","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Path"},"670":{"id":"/docs/explanation/artifact-format-86","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Description"},"671":{"id":"/docs/explanation/artifact-format-87","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`--input <file>` (CLI)"},"672":{"id":"/docs/explanation/artifact-format-88","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"MIME detection + parser resolution; PDF uses built-in `parsePdf`"},"673":{"id":"/docs/explanation/artifact-format-89","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`--stdin` (CLI)"},"674":{"id":"/docs/explanation/artifact-format-90","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"MIME detection on buffer; `text/plain` falls back to text artifact"},"675":{"id":"/docs/explanation/artifact-format-91","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`parse()` (SDK)"},"676":{"id":"/docs/explanation/artifact-format-92","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Accepts `kind: \"text\"`, `kind: \"file\"`, `kind: \"buffer\"`, `kind: \"artifact-json\"`"},"677":{"id":"/docs/explanation/artifact-format-93","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"`urlToArtifact()` (SDK)"},"678":{"id":"/docs/explanation/artifact-format-94","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#built-in-artifact-creation","content":"Fetches URL, validates as `SerializedArtifact[]`"},"679":{"id":"/docs/explanation/artifact-format-95","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#see-also","content":"Document Parsing — how to get input into Struktur and how files are converted to artifacts"},"680":{"id":"/docs/explanation/artifact-format-96","page_id":"/docs/explanation/artifact-format","tags":[],"type":"text","url":"/docs/explanation/artifact-format#see-also","content":"parse() — the SDK API"},"681":{"id":"/docs/explanation/chunking","page_id":"/docs/explanation/chunking","type":"page","content":"Chunking & Token Budgets","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/chunking"},"682":{"id":"/docs/explanation/chunking-0","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking","content":"How large documents are split and merged to fit within context windows."},"683":{"id":"/docs/explanation/chunking-1","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#the-context-window-problem","content":"The context window problem"},"684":{"id":"/docs/explanation/chunking-2","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#how-splitting-works","content":"How splitting works"},"685":{"id":"/docs/explanation/chunking-3","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#images-and-maximages","content":"Images and `maxImages`"},"686":{"id":"/docs/explanation/chunking-4","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"Why `simple` does not chunk"},"687":{"id":"/docs/explanation/chunking-5","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#merging-partial-results","content":"Merging partial results"},"688":{"id":"/docs/explanation/chunking-6","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"LLM merge (parallel, doublePass)"},"689":{"id":"/docs/explanation/chunking-7","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"Schema-aware auto-merge"},"690":{"id":"/docs/explanation/chunking-8","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#deduplication","content":"Deduplication"},"691":{"id":"/docs/explanation/chunking-9","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#when-dedup-matters","content":"When dedup matters"},"692":{"id":"/docs/explanation/chunking-10","page_id":"/docs/explanation/chunking","type":"heading","tags":[],"url":"/docs/explanation/chunking#see-also","content":"See also"},"693":{"id":"/docs/explanation/chunking-11","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#the-context-window-problem","content":"LLMs have finite context windows. Documents — especially multi-page PDFs, large datasets, or many files at once — often exceed them. Struktur's chunker splits artifact contents into batches that fit within a configurable token budget (`chunkSize`)."},"694":{"id":"/docs/explanation/chunking-12","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"Splitting happens at two levels:"},"695":{"id":"/docs/explanation/chunking-13","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactSplitter:** splits a single large artifact's contents into smaller parts, respecting content slice boundaries (e.g., page boundaries)."},"696":{"id":"/docs/explanation/chunking-14","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"**ArtifactBatcher:** groups artifacts or artifact parts into batches that stay within the token budget and optional image count limit."},"697":{"id":"/docs/explanation/chunking-15","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#how-splitting-works","content":"The tokenizer uses a character-approximation (not exact token counting). `chunkSize` defaults to 10,000 tokens."},"698":{"id":"/docs/explanation/chunking-16","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#images-and-maximages","content":"Some strategies accept `maxImages` to cap how many images appear per chunk. This matters when images consume disproportionate context. If a batch would exceed `maxImages`, extra images are moved to the next batch."},"699":{"id":"/docs/explanation/chunking-17","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"The `simple` strategy loads all artifacts as-is. If the input exceeds the context window, the LLM call may fail or produce degraded results. For large inputs, use a chunked strategy."},"700":{"id":"/docs/explanation/chunking-18","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#why-simple-does-not-chunk","content":"This is a deliberate trade-off: `simple` is fast and cheap for small inputs, not suitable for large ones."},"701":{"id":"/docs/explanation/chunking-19","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"When a document is split into N chunks and each chunk is extracted independently, you get N partial objects."},"702":{"id":"/docs/explanation/chunking-20","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For a scalar-heavy schema (title, author, date), you want the best answer from all chunks."},"703":{"id":"/docs/explanation/chunking-21","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#merging-partial-results","content":"For an array-heavy schema (line items, product listings), you want to concatenate all arrays and remove duplicates."},"704":{"id":"/docs/explanation/chunking-22","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"These strategies send all partial results to a **merge model** in a single call, with a prompt asking it to produce a single coherent output. The merge model sees the full schema and all partial outputs."},"705":{"id":"/docs/explanation/chunking-23","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#llm-merge-parallel-doublepass","content":"This is powerful but costs extra tokens."},"706":{"id":"/docs/explanation/chunking-24","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"`parallelAutoMerge`, `sequentialAutoMerge`, and `doublePassAutoMerge` use `SmartDataMerger`:"},"707":{"id":"/docs/explanation/chunking-25","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Arrays:** concatenated. `items` from chunk 1 + `items` from chunk 2 = `items` in merged."},"708":{"id":"/docs/explanation/chunking-26","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Objects:** shallow-merged. Keys from later chunks overwrite keys from earlier ones."},"709":{"id":"/docs/explanation/chunking-27","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"**Scalars:** prefer newer non-empty values."},"710":{"id":"/docs/explanation/chunking-28","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#schema-aware-auto-merge","content":"This approach avoids an extra LLM call and works well for list-extraction schemas. It does not handle complex cross-chunk synthesis — for that, use LLM merge."},"711":{"id":"/docs/explanation/chunking-29","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"After auto-merging concatenated arrays, there may be duplicates. Dedup runs in two stages:"},"712":{"id":"/docs/explanation/chunking-30","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 1: CRC32 hash-based.** Exact duplicates (byte-for-byte identical after stable JSON stringification) are removed without any LLM call. Fast and cheap."},"713":{"id":"/docs/explanation/chunking-31","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"**Stage 2: LLM-based semantic dedup.** A dedupe model is given the merged array and asked to identify semantically equivalent entries (e.g., \"iPhone 15\" vs \"Apple iPhone 15 128GB\"). It returns a list of dot-path keys to remove (e.g., `items.3`)."},"714":{"id":"/docs/explanation/chunking-32","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#deduplication","content":"Only the auto-merge variants include this step."},"715":{"id":"/docs/explanation/chunking-33","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup is valuable when:"},"716":{"id":"/docs/explanation/chunking-34","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same item legitimately appears in multiple chunks."},"717":{"id":"/docs/explanation/chunking-35","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"The same document segment appears in multiple artifacts."},"718":{"id":"/docs/explanation/chunking-36","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#when-dedup-matters","content":"Dedup adds token cost and latency. For schemas without arrays, or for inputs with no expected overlap, use strategies without auto-merge."},"719":{"id":"/docs/explanation/chunking-37","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"The Extraction Pipeline — the full flow"},"720":{"id":"/docs/explanation/chunking-38","page_id":"/docs/explanation/chunking","tags":[],"type":"text","url":"/docs/explanation/chunking#see-also","content":"Extraction Strategies — which strategies use chunking"},"721":{"id":"/docs/explanation/document-parsing","page_id":"/docs/explanation/document-parsing","type":"page","content":"Document Parsing","breadcrumbs":["Struktur","Concepts"],"tags":[],"url":"/docs/explanation/document-parsing"},"722":{"id":"/docs/explanation/document-parsing-0","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"How Struktur converts files into Artifacts before extraction."},"723":{"id":"/docs/explanation/document-parsing-1","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#mime-detection","content":"MIME Detection"},"724":{"id":"/docs/explanation/document-parsing-2","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#built-in-parsers","content":"Built-in Parsers"},"725":{"id":"/docs/explanation/document-parsing-3","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#built-in-input-types","content":"Built-in Input Types"},"726":{"id":"/docs/explanation/document-parsing-4","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#plain-text--markdown-cli","content":"Plain text / markdown (CLI)"},"727":{"id":"/docs/explanation/document-parsing-5","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#artifact-json-cli","content":"Artifact JSON (CLI)"},"728":{"id":"/docs/explanation/document-parsing-6","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#schema-loading","content":"Schema loading"},"729":{"id":"/docs/explanation/document-parsing-7","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#custom-parsers","content":"Custom Parsers"},"730":{"id":"/docs/explanation/document-parsing-8","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-1-configuration-level-recommended","content":"Option 1: Configuration-level (recommended)"},"731":{"id":"/docs/explanation/document-parsing-9","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-2-sdk-level-inline-parser","content":"Option 2: SDK-level inline parser"},"732":{"id":"/docs/explanation/document-parsing-10","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#the-inline-parser-signature","content":"The inline parser signature"},"733":{"id":"/docs/explanation/document-parsing-11","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#common-patterns","content":"Common patterns"},"734":{"id":"/docs/explanation/document-parsing-12","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#excel-with-xlsx-package","content":"Excel with xlsx package"},"735":{"id":"/docs/explanation/document-parsing-13","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#email-with-mailparser","content":"Email with mailparser"},"736":{"id":"/docs/explanation/document-parsing-14","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#option-3-legacy-providers-deprecated","content":"Option 3: Legacy providers (deprecated)"},"737":{"id":"/docs/explanation/document-parsing-15","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#npm-package-parser","content":"npm Package Parser"},"738":{"id":"/docs/explanation/document-parsing-16","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#shell-command-parsers","content":"Shell Command Parsers"},"739":{"id":"/docs/explanation/document-parsing-17","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#file-based","content":"File-based"},"740":{"id":"/docs/explanation/document-parsing-18","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#stdin-based","content":"Stdin-based"},"741":{"id":"/docs/explanation/document-parsing-19","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parser-resolution-order","content":"Parser Resolution Order"},"742":{"id":"/docs/explanation/document-parsing-20","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#ad-hoc-parser-override","content":"Ad-hoc Parser Override"},"743":{"id":"/docs/explanation/document-parsing-21","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#sdk-usage","content":"SDK Usage"},"744":{"id":"/docs/explanation/document-parsing-22","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#parseinput-options","content":"`parse(input, options?)`"},"745":{"id":"/docs/explanation/document-parsing-23","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#filetoartifactbuffer-options","content":"`fileToArtifact(buffer, options)`"},"746":{"id":"/docs/explanation/document-parsing-24","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#urltoartifacturl","content":"`urlToArtifact(url)`"},"747":{"id":"/docs/explanation/document-parsing-25","page_id":"/docs/explanation/document-parsing","type":"heading","tags":[],"url":"/docs/explanation/document-parsing#see-also","content":"See also"},"748":{"id":"/docs/explanation/document-parsing-26","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing","content":"Struktur's parser system converts files into Artifact format before any LLM work happens. Parsers are resolved by MIME type and are fully configurable."},"749":{"id":"/docs/explanation/document-parsing-27","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"MIME type is detected in three layers (tried in order):"},"750":{"id":"/docs/explanation/document-parsing-28","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**Magic bytes** (authoritative): PDF (`%PDF-`), PNG, JPEG, GIF, WebP, and ZIP-based Office formats are identified from the first bytes of the file."},"751":{"id":"/docs/explanation/document-parsing-29","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**npm `detectFileType` callback**: A custom npm parser may export a `detectFileType(header: Uint8Array): boolean` function to claim MIME types beyond what magic bytes cover."},"752":{"id":"/docs/explanation/document-parsing-30","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"**File extension database**: Fallback for inputs where magic bytes don't match a known signature."},"753":{"id":"/docs/explanation/document-parsing-31","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#mime-detection","content":"Override MIME detection with `--mime <type>` on any command that accepts input."},"754":{"id":"/docs/explanation/document-parsing-32","page_id":"/docs/explanation/document-parsing","tags":[],"type":"text","url":"/docs/explanation/document-parsing#built-in-parsers","content":"MIME type"},"755":{"id":"/docs/explanation/document-parsing-33","page_id":"/docs/explanation/d