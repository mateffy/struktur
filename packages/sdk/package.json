    "@sinclair/typebox": "^0.34.48",
    "ai": "^6.0.97",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "just-bash": "^2.11.15",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
