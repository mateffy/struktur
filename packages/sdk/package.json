{
  "name": "@struktur/sdk",
  "version": "2.4.1",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./strategies": {
      "types": "./dist/strategies.d.ts",
      "import": "./dist/strategies.js"
    },
    "./parsers": {
      "types": "./dist/parsers.d.ts",
      "import": "./dist/parsers.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/provider": "^3.0.8",
    "@openrouter/ai-sdk-provider": "^2.0.0",
    "@sinclair/typebox": "^0.34.48",
    "@struktur/fields": "workspace:*",
    "ai": "^6.0.97",
    "just-bash": "^2.11.15",
    "ollama-ai-provider-v2": "^3.5.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@llamaindex/liteparse": "^1",
    "@kreuzberg/node": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.0"
  }
